# Deny by default. A root build context must not contain local runtime/private data.
**

# Build definitions.
!.dockerignore
!Dockerfile.web
!Dockerfile.backend

# Frontend build inputs only; never use host node_modules or prebuilt dist.
!web/
!web/package.json
!web/package-lock.json
!web/index.html
!web/tsconfig.json
!web/vite.config.ts
!web/src/
!web/src/**/
!web/src/**/*.ts
!web/src/**/*.vue
!web/src/**/*.css

# Backend module/build/test inputs.
!backend/
!backend/go.mod
!backend/go.sum
!backend/cmd/
!backend/cmd/**/
!backend/cmd/**/*.go
!backend/internal/
!backend/internal/**/
!backend/internal/**/*.go

# Runtime proxy configuration is the sole included deployment asset.
!deploy/
!deploy/nginx.conf

# Defense in depth: these exclusions override any allowlist entry above.
**/.env
**/.env.*
**/.git/**
**/.runtime/**
**/evidence/**
**/.evidence/**
**/logs/**
**/private/**
**/archives/**
**/node_modules/**
**/vendor/**
**/deps/**
**/dist/**
**/bin/**
**/__pycache__/**
**/*.log
**/*.pem
**/*.key
**/*.pfx
**/*.zip
**/*.7z
**/*.tar
**/*.tar.gz
**/*.sql
**/*.bak
