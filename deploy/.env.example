# Copy to .env.deploy beside compose.deploy.yaml. Keep chmod 600; do not commit.
# The Compose file itself is standalone: no external SQL/config file is needed.
DEPLOY_NAMESPACE=yishuld-refund-server
REGISTRY=crpi-vpvynwydljgcai3w.cn-guangzhou.personal.cr.aliyuncs.com
IMAGE_NAMESPACE=pandacount
IMAGE_TAG=0.1.0

# Default loopback is deliberate. For remote IP:port access, explicitly set
# BIND_IP=0.0.0.0 after restricting the server firewall/security-group sources.
BIND_IP=127.0.0.1
WEB_PORT=8080
# Required; e.g. http://192.0.2.10:8080. Replace with the actual server address.
# No path, trailing slash, wildcard, or guessed IP. Must match the browser URL.
APP_ORIGIN=
SESSION_COOKIE_SECURE=false

# Generate separately twice with: openssl rand -hex 32
# Both must be different random 64-hex-character values. Blank values fail closed.
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

# Explicitly enable current-merchant data reset for repeatable fictional testing.
# Set false to hide/reject the maintenance action. This is not production RBAC.
ENABLE_DATA_RESET=true
