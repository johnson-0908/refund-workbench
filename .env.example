# Local, fictional demo settings only. Do not use production credentials.
# Compose reads port overrides. Backend reads exported process environment.
MYSQL_PORT=3307
REDIS_PORT=6379
KAFKA_PORT=19092
MYSQL_DSN=demo:demo-refund-only@tcp(127.0.0.1:3307)/refund_demo?parseTime=true&loc=UTC
REDIS_ADDR=127.0.0.1:6379
KAFKA_BROKERS=127.0.0.1:19092
KAFKA_TOPIC=refund.events
KAFKA_GROUP=refund-workbench-activity
HTTP_ADDR=127.0.0.1:18080
# Keep disabled for the ERP browser. Only original exercise CLI acceptance opts in.
ENABLE_DEMO_BEARER=false
# Go defaults to false. dev.ps1 explicitly enables the local per-merchant reset UI.
ENABLE_DATA_RESET=true
